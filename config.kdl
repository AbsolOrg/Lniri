// Lniri Configuration Example with Liquid Glass engine
// Configuration path: ~/.config/Lniri/config.kdl (or ~/.config/lniri/config.kdl)
// Keeping this isolated allows standard Niri to use ~/.config/niri/config.kdl without syntax errors!

window-rule {
    match app-id=".*"
    draw-border-with-background false
    background-effect {
        blur true
        xray true
        liquid-glass {
            liquidity 1.0               // Fluid droplet meniscus & corner pooling (matches kwin-effects-glass liquid_enough.png)
            refraction-strength 4.5
            power-factor 3.5
            refraction-power 1.5
            edge-thickness 0.18
            glow-weight 0.0
            edge-lighting 0.6
            saturation 1.15
            vibrancy 0.35
            adaptive-dim 0.1
            adaptive-boost 0.15
            physical-refraction 1.0
            lens-distortion 0.15
            fringing 0.45
        }
    }
}

// Layer Shell Rules (bars, docks, launchers, e.g. mistbar, waybar, fuzzel)
layer-rule {
    match namespace="^mistbar.*"
    match namespace="^waybar.*"
    match namespace="^bar.*"
    geometry-corner-radius 12
    background-effect {
        blur true
        xray true // Set xray false if you want the bar to refract windows underneath
        liquid-glass {
            refraction-strength 5.0
            power-factor 3.5
            refraction-power 1.8
            edge-thickness 0.20
            edge-lighting 0.8
            glow-weight 0.0
            saturation 1.2
            vibrancy 0.35
            physical-refraction 1.0
            fringing 0.45
        }
    }
}

